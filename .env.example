SPRING_APPLICATION_NAME=stardy-user
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/User
SPRING_DATASOURCE_USERNAME=change-me
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

POSTGRES_DB=User
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379

JWT_SECRET=replace-with-a-secure-secret-at-least-32-bytes
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000
JWT_TEMPORARY_CODE_EXPIRATION=30000

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
NAVER_CLIENT_ID=replace-with-naver-client-id
NAVER_CLIENT_SECRET=replace-with-naver-client-secret
NAVER_REDIRECT_URI=http://localhost:8080/login/oauth2/code/naver
OAUTH2_FRONTEND_REDIRECT_URI=http://localhost:3000/oauth/callback
